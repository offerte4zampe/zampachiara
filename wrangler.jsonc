{
  "name": "zampachiara",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/metrics"
    ]
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "offerte4zampe.it",
      "custom_domain": true
    }
  ],
  "main": "worker/index.mjs",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
