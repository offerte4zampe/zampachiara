{
  "name": "zampachiara",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/index.html",
      "/confronta-cibo.html",
      "/*.html",
      "/api/metrics",
      "/prodotto",
      "/prodotto.html",
      "/prodotto/*",
      "/api/telegram/status",
      "/go/*"
    ]
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "offerte4zampe.it",
      "custom_domain": true
    }
  ],
  "main": "worker/index.mjs",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "keep_vars": true,
  "vars": {
    "SHIPPING_RULES_SOURCE": "json",
    "SHIPPING_SHADOW": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TELEGRAM_PUBLISHER",
        "class_name": "TelegramPublisher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "telegram-v1",
      "new_sqlite_classes": [
        "TelegramPublisher"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "build": {
    "command": "python automation/check_d1_activation.py --prepare-build && python automation/apply_navigation.py && python automation/apply_freshness.py && python automation/clean_urls.py && python automation/apply_micro_fixes.py"
  },
  "analytics_engine_datasets": [
    {
      "binding": "OUTBOUND_CLICKS",
      "dataset": "offerte4zampe_outbound"
    }
  ]
}
